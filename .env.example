# -----------------------------------------------------------------------
# Gerado via: vercel env pull .env.local
# Nunca commitar .env.local — já está no .gitignore
# -----------------------------------------------------------------------

# Conexao direta ao Postgres (sem pooler) — usado pelo bootstrap Python
# Vercel integration: spdb_passando_da_sena_beta_POSTGRES_URL_NON_POOLING
SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# -----------------------------------------------------------------------
# Vars geradas automaticamente pelo vercel env pull (prefixo do integration)
# -----------------------------------------------------------------------

# Supabase API
spdb_passando_da_sena_beta_SUPABASE_URL=https://[project-ref].supabase.co
spdb_passando_da_sena_beta_SUPABASE_ANON_KEY=eyJ...
spdb_passando_da_sena_beta_SUPABASE_SERVICE_ROLE_KEY=eyJ...
spdb_passando_da_sena_beta_SUPABASE_JWT_SECRET=

# Postgres (Vercel Postgres / Supabase)
spdb_passando_da_sena_beta_POSTGRES_URL=postgres://...          # pooled (Supavisor) — usar no app
spdb_passando_da_sena_beta_POSTGRES_URL_NON_POOLING=postgres://... # direto — usar no bootstrap
spdb_passando_da_sena_beta_POSTGRES_HOST=
spdb_passando_da_sena_beta_POSTGRES_DATABASE=
spdb_passando_da_sena_beta_POSTGRES_USER=
spdb_passando_da_sena_beta_POSTGRES_PASSWORD=

# Expostos ao browser pelo Next.js
NEXT_PUBLIC_spdb_passando_da_sena_beta_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_spdb_passando_da_sena_beta_SUPABASE_ANON_KEY=eyJ...
